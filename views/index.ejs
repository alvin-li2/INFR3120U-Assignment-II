<!DOCTYPE html>
<html>

<head>
  <title>
    <%= title %>
  </title>
  <link rel='stylesheet' href='/content/app.css' />
  <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/@fortawesome/fontawesome-free/css/all.min.css" />
  <script src="/script/app.js"></script>
  <script src="bootstrap/dist/js/bootstrap.min.js"></script>
</head>

<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">INFR3120</a>
      <button class="btn-icon navbar-toggler" type="button" data-bs-toggle="drawer" data-bs-target="#navbarDrawer"
        aria-controls="navbarDrawer" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="drawer-body mb-2 md:mb-0">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <% if (title=="Home" ) {%>
              <a class="nav-link active" aria-current="page" href="/home"><i class="fa-solid fa-house"></i></i>Home</a>
              <% } else { %>
                <a class="nav-link" aria-current="page" href="/home"><i class="fa-solid fa-house"></i></i>Home</a>
                <% } %>
          </li>
          <li class="nav-item">
            <% if (title=="About me" ) {%>
              <a class="nav-link active" aria-current="page" href="/aboutme"> <i class="fa-solid fa-circle-info"></i>
                About me</a>
              <% } else { %>
                <a class="nav-link" aria-current="page" href="/aboutme"><i class="fa-solid fa-house"></i></i>About
                  me</a>
                <% } %>
          </li>
          <li class="nav-item">
            <% if (title=="Projects" ) {%>
              <a class="nav-link active" aria-current="page" href="/projects"> <i
                  class="fa-solid fa-diagram-project"></i>
                Projects</a>
              <% } else { %>
                <a class="nav-link" aria-current="page" href="/projects"> <i class="fa-solid fa-diagram-project"></i>
                  Projects</a>
                <% } %>
          </li>
          <li class="nav-item">
            <% if (title=="Contact me" ) {%>
              <a class="nav-link active" aria-current="page" href="/contact"> <i class="fa-solid fa-phone"></i> Contact
                me</a>
              <% } else { %>
                <a class="nav-link" aria-current="page" href="/contact"> <i class="fa-solid fa-phone"></i> Contact
                  me</a>
                <% } %>
          </li>
      </div>
    </div>
  </nav>
  <h1>Welcome to My <%= title %> Page</h1>
  <% if (title=="Home" ) {%>
    <div>
      <h2>This is the home page of my Website, you can find the navigation features in the top left of your screen.
        I
        hope you enjoy it!</h2>
    </div>
    <% } %>
      <% if (title=="Contact me" ) {%>
        <div>
          <form action="mailto:alvin.li@ontariotechu.net?subject=Feedback_Regarding_Website" method="post"
            enctype="text/plain" name="feedback">
            <p>
              <label for="firstName">Enter your First Name</label>
              <input type="text" id="firstName" size="32" placeholder="Enter your First Name" required>
            </p>
            <p>
              <label for="lastName">Enter your Last Name</label>
              <input type="text" id="lastName" size="32" placeholder="Enter your Last Name" required>
            </p>
            <p>
              <label for="email">Enter your Email Address</label>
              <input type="email" id="email" size="32" placeholder="Enter your Email Address" required>
            </p>
            <p>
              <label for="phone">Enter your Phone Number Here (optional)</label>
              <input type="tel" id="phone" size="32" placeholder="Enter your Phone Number Here">
            </p>
            <p>
              <label for="message">Enter your Message</label><br>
              <textarea name="message" id="message" cols="60" rows="8" placeholder="Enter your Message Here"
                required></textarea>
            </p>
            <p>
              <input type="submit" value="Submit">
            </p>
          </form>
        </div>
        <% } %>
          </p>
</body>

</html>